# Copy to apps/api/.env.local (gitignored) and fill in. Never commit real keys.

# Claude, required for the agent and the eval. From the hackathon credits email.
ANTHROPIC_API_KEY=

# TypeSafe Jev, optional. Without it the perspectives panel is skipped.
TYPESAFE_API_KEY=

# Origin the API accepts browser requests from (CORS). Defaults to http://localhost:3000.
WEB_ORIGIN=http://localhost:3000

# ElevenLabs, planned for the voice layer (PRD Part I). No code reads it yet.
# ELEVENLABS_API_KEY=
