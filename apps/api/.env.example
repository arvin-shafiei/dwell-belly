# Copy to apps/api/.env.local (gitignored) and fill in. Never commit real keys.

# Claude, required for the agent and the eval. From the hackathon credits email.
ANTHROPIC_API_KEY=

# TypeSafe Jev, optional. Without it the perspectives panel is skipped.
TYPESAFE_API_KEY=

# Origin the API accepts browser requests from (CORS). Defaults to http://localhost:3000.
WEB_ORIGIN=http://localhost:3000

# ElevenLabs, for voice (PRD Part I): speech-to-text, the Desk Caller agent, call tokens.
# Needs Conversational AI write, Speech to Text, Text to Speech and Voices read permissions.
# Without it, audio files in a case are listed as not transcribed and voice is off.
ELEVENLABS_API_KEY=
# Printed by: node --env-file=apps/api/.env.local scripts/voice/create-agent.mjs
ELEVENLABS_AGENT_ID=
# Optional model for the Desk Caller agent, used when creating it. Default: claude-haiku-4-5.
# ELEVENLABS_AGENT_LLM=
