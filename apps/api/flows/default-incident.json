{
  "id": "default-incident",
  "name": "Default incident flow",
  "business": "Generic last-mile delivery",
  "nodes": [
    { "id": "ingest", "type": "ingest", "runs_on": ["code", "claude"] },
    { "id": "history", "type": "history_lookup", "runs_on": ["code"] },
    { "id": "triage", "type": "triage", "runs_on": ["jev"] },
    { "id": "clash", "type": "clash_check", "runs_on": ["claude", "jev"] },
    { "id": "planner", "type": "planner", "runs_on": ["claude"] },
    { "id": "gate", "type": "safety_gate", "runs_on": ["jev", "code"], "config": { "allow_below": 0.3, "block_above": 0.8 } },
    { "id": "human", "type": "human_decision", "runs_on": ["claude", "code"] },
    { "id": "action", "type": "action", "runs_on": ["code"] },
    { "id": "verify", "type": "verify", "runs_on": ["jev"] },
    { "id": "log", "type": "case_log", "runs_on": ["code"] }
  ],
  "edges": [
    { "from": "ingest", "to": "history" },
    { "from": "history", "to": "triage" },
    { "from": "triage", "to": "clash" },
    { "from": "clash", "to": "planner" },
    { "from": "planner", "to": "gate" },
    { "from": "gate", "to": "action", "when": "allow" },
    { "from": "gate", "to": "human", "when": "ask" },
    { "from": "gate", "to": "log", "when": "block" },
    { "from": "human", "to": "action" },
    { "from": "action", "to": "verify" },
    { "from": "verify", "to": "log" }
  ]
}
